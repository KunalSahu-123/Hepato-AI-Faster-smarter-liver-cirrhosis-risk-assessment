# =============================================================================
# LiverAI — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# In development the defaults below are fine. In production every value
# marked REQUIRED must be set.
# =============================================================================

# --- Core -------------------------------------------------------------------
# REQUIRED in production. A long random string used to sign sessions and tokens.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-in-production

# "development" | "production". Controls debug helpers and demo-mode display.
ENV_NAME=development

# --- Database ----------------------------------------------------------------
# SQLAlchemy URL. Defaults to an SQLite file in the project folder.
# PostgreSQL example: postgresql+psycopg2://user:pass@host:5432/liverai
# Heroku/Render "postgres://" URLs are auto-normalised.
DATABASE_URL=sqlite:///liver_cirrhosis.db

# --- Security & sessions ----------------------------------------------------
# Set to 1 when serving over HTTPS (production).
COOKIE_SECURE=0

# CSRF protection (leave enabled; disable only for automated testing).
# WTF_CSRF_ENABLED=1

# --- Auth hardening ----------------------------------------------------------
MAX_LOGIN_ATTEMPTS=8
LOGIN_LOCKOUT_MINUTES=15

# Password-reset token lifetime in seconds (default 1 hour).
RESET_TOKEN_MAX_AGE_SECONDS=3600

# Minimum password length enforced on registration and change.
# PASSWORD_MIN_LENGTH is set in config.py (default 8).

# --- Bootstrap admin ---------------------------------------------------------
# Credentials for the auto-created admin account on first run.
ADMIN_EMAIL=admin@liverai.com
ADMIN_PASSWORD=Admin@123

# --- Uploads -----------------------------------------------------------------
# Maximum file size in MB for lab-report image uploads.
MAX_REPORT_SIZE_MB=10

# --- OCR (optional) ----------------------------------------------------------
# Path to the Tesseract binary. Leave blank if Tesseract is on PATH.
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# --- AI Chatbot (Groq recommended - fastest and free) -----------------------
# Groq: Get free key at https://console.groq.com/keys
# Free: 30 req/min, 14,400 req/day with Llama 3.3 70B
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini (fallback): Get free key at https://aistudio.google.com/apikey
# Free: 15 req/min, 1M tokens/day
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Pagination --------------------------------------------------------------
ITEMS_PER_PAGE=10
